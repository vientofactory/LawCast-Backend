{
  "name": "lawcast-backend",
  "version": "3.0.0",
  "description": "",
  "author": "vientorepublic",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "license": "MIT",
  "scripts": {
    "build": "npm run check:native && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "NODE_ENV=production nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:openapi": "sh scripts/start-local-openapi.sh",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "test": "npm run test:vendor && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --testRegex .*\\.e2e-spec\\.ts$ --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "check:native": "node node_modules/typescript-native/bin/tsc --noEmit",
    "test:vendor": "node --test vendor/deepmerge/security.test.cjs",
    "test:redis-migration": "node scripts/verify-redis-migration.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vientofactory/Lawcast-Backend.git"
  },
  "bugs": {
    "url": "https://github.com/vientofactory/Lawcast-Backend/issues"
  },
  "homepage": "https://github.com/vientofactory/Lawcast-Backend#readme",
  "dependencies": {
    "@file-kiwi/node": "^1.0.9",
    "@keyv/redis": "^6.1.0",
    "@nestjs/cache-manager": "^12.0.4",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "@notionhq/client": "^5.31.0",
    "axios": "^1.21.0",
    "better-sqlite3": "^12.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "cronstrue": "^3.38.0",
    "discord-webhook-node": "^1.1.8",
    "discord.js": "^14.28.1",
    "hashguard-client": "^1.5.2",
    "jszip": "^3.10.2",
    "keyv": "^6.1.0",
    "node-cache": "^5.1.2",
    "notion-to-md": "^3.1.9",
    "pal-crawl": "^2.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.1.2",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "^30.5.2",
    "deepmerge": "file:./vendor/deepmerge",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "test-exclude": "^8.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "js-yaml": "^5.5.0",
    "glob": "^14.0.4",
    "node-gyp": "^13.0.0",
    "tar": "^7.5.9",
    "babel-plugin-istanbul": "^8.0.0",
    "multer": "2.5.0",
    "@puppeteer/browsers": "^3.2.2",
    "minimatch": "^11.0.5",
    "deepmerge": "$deepmerge"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "puppeteer@22.15.0": true,
    "sqlite3@6.0.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.11.1": true
  }
}
