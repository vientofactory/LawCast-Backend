# 서버 설정
PORT=3001
NODE_ENV=production

# 데이터베이스 설정
DATABASE_PATH=lawcast.db

# Redis 캐시 설정
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=lawcast:
REDIS_TTL=1800

# HashGuard(PoW) API 설정 (선택사항)
HASHGUARD_API_URL=https://hashguard.viento.me

# Ollama 요약 API 설정 (선택사항)
OLLAMA_ENABLED=true
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b # 명시하지 않을 경우 기본값으로 gemma3:1b 사용
OLLAMA_TIMEOUT=10000

# 시맨틱 검색 사이드카 설정 (선택사항, 사이드카 미실행 시 키워드 검색으로 자동 폴백)
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_SEARCH_API_URL=http://127.0.0.1:8300
SEMANTIC_SEARCH_TIMEOUT=10000
# 사이드카가 /health로 보고하는 청크 상한(maxK)을 다시 읽는 주기(ms). 사이드카의 LAWCAST_SEMANTIC_MAX_K 변경이 이 주기 안에 반영된다. 0이면 매 검색마다 재조회.
SEMANTIC_SEARCH_CHUNK_CAP_REFRESH_MS=60000

# Notion 관리자 공지 게시판 (선택사항, 미설정 시 공지 기능 비활성)
# Notion 데이터베이스 속성: 제목(title), 공개 여부(checkbox), 상태(status),
# 노출 순서(number), 내용(rich text)
NOTION_API_KEY=
NOTION_DATABASE_ID=
# NOTION_API_URL=https://api.notion.com
# NOTION_TIMEOUT=5000
# NOTION_CACHE_TTL_MS=60000  # 인메모리 공지 캐시 TTL(ms), 0 이하면 캐시 사용 안 함
# NOTION_MIN_REQUEST_INTERVAL_MS=340  # Notion 요청 최소 간격(ms), 0 이하면 페이싱 비활성

# 크론 작업 시간대
CRON_TIMEZONE=Asia/Seoul

# CORS 허용 도메인 (쉼표로 구분)
FRONTEND_URL=http://localhost:5173,http://localhost:3002

# Discord 디버그 브릿지 (선택사항)
# 브릿지 전체 활성화 여부
DISCORD_BRIDGE_ENABLED=false
# Discord 봇 토큰 (Discord Developer Portal > Bot > Token)
DISCORD_BRIDGE_BOT_TOKEN=
# 길드(서버) ID — 설정 시 슬래시 명령어가 해당 길드에 즉시 등록됨
# 미설정 시 글로벌 등록 (전파까지 최대 1시간 소요)
DISCORD_BRIDGE_GUILD_ID=
# 명령어를 수신할 브릿지 채널 ID (Snowflake)
DISCORD_BRIDGE_CHANNEL_ID=
# 이벤트 로그를 전송할 로그 채널 ID (Snowflake)
DISCORD_BRIDGE_LOG_CHANNEL_ID=
# 로그 레벨: ERROR | WARN | LOG | DEBUG | VERBOSE (기본값: LOG)
DISCORD_BRIDGE_LOG_LEVEL=LOG
# 브릿지 명령어를 사용할 수 있는 Discord 유저 ID (쉼표로 구분)
DISCORD_BRIDGE_ADMIN_USER_IDS=
# /notices 검색의 의미 검색 모드가 한 번에 조회하는 공고(후보) 최대 개수. 사이드카 청크 상한(SIDE_CAR_MAX_CHUNK_K) 안에서 동작한다.
SEMANTIC_SEARCH_HYBRID_MAX_NOTICES=100

# 크롤러 소스 활성화 (소스별 독립 제어)
# PAL: 국회 입법예고(pal.assembly.go.kr), NSM: 국민참여입법센터(opinion.lawmaking.go.kr)
# 미설정/빈 값/알 수 없는 값은 활성(true)으로 처리된다(opt-out).
# 두 소스를 모두 false 로 설정하면 부트스트랩에서 예외가 발생하고 프로세스가 종료된다(process.exit(1)).
# 비활성화된 소스는 데이터 수집은 물론 스냅샷 저장·변경 추적 경로에도 진입하지 않는다.
CRAWLING_PAL_ENABLED=true
CRAWLING_NSM_ENABLED=true
# 크롤러 User-Agent 고정 (기본: 미설정 = 실제 브라우저 UA 순환).
#   미설정: 요청마다 브라우저 UA 풀(browser-identities.util.ts)에서 하나를 골라 쓰고,
#           그 UA가 보내는 클라이언트 힌트(sec-ch-ua*)·Sec-Fetch-*·Upgrade-Insecure-Requests
#           헤더까지 함께 보낸다. UA와 힌트가 서로 다른 브라우저를 가리키면 그 자체가 봇 신호다.
#   설정 시: 모든 요청이 이 값을 그대로 쓰고 브라우저 힌트는 보내지 않는다(제품 토큰 고정).
#           UA 차단을 피하려는 목적이라면 비워 두는 편이 낫다.
# CRAWLING_USER_AGENT=
# NSM 목록/상세 수집 소스 선택 (기본: nsm).
#   nsm   = 국민참여입법센터 입법진행현황(opinion.lawmaking.go.kr, NsmLmSts)
#   likms = 국회 의안정보시스템 계류의안(likms.assembly.go.kr, pal-crawl LikmsNsmAdapter)
# likms 로 설정해도 동일한 NSM 포트로 수집되므로 기존 파이프라인(아카이브·캐시·알림)을 그대로 탄다.
# 알 수 없는 값은 기본값(nsm)으로 처리된다(opt-in).
# CRAWLING_NSM_SOURCE=likms
# NSM 소스 삭제 감지 킬 스위치 (NSM 이 활성인 경우에만 동작). false 면 삭제 감지를 건너뛴다.
# CRAWLING_NSM_DELETION_DETECTION_ENABLED=true
# NSM 목록 관찰 기록(nsm_last_seen_in_list_at)은 감지가 꺼져 있어도 계속 남으므로,
# 다시 켜면 "감지가 꺼져 있던 동안 목록에서 사라진 행"만 후보가 된다.
# 목록에서 사라진 행의 삭제 프로브 상한과 재프로브 쿨다운.
#   상한(기본 50): 1회 통과에서 프로브할 최대 후보 수.
#   쿨다운 시간(기본 168=7일): 삭제가 확정되지 않은 행을 다시 후보로 올리기까지의 간격.
#   쿨다운이 없으면 매 사이클 같은 후보 집합을 다시 프로브한다(차단된 포털에 수천 건/사이클).
# ARCHIVE_SYNC_NSM_MISSING_PROBE_MAX_CANDIDATES=50
# ARCHIVE_SYNC_NSM_LIST_ABSENCE_REPROBE_COOLDOWN_HOURS=168
# 포털이 모든 상세 요청을 거부할 때(읽을 수 있는 페이지 0건) 연속 몇 건에서 통과를 중단할지(기본 5).
# ARCHIVE_SYNC_NSM_MISSING_PROBE_UNUSABLE_ABORT_THRESHOLD=5
# 목록 스캔이 0건을 반환하면 '신규 없음'이 아니라 실패 관찰로 취급한다(경고→연속 시 오류 승격).
#   임계값(기본 3): 연속 0건 스캔이 이 횟수에 도달하면 수집 중단(degraded)으로 보고한다.
#   반복 알림 시간(기본 6): degraded 상태가 계속될 때 오류 알림을 다시 보내는 간격(시간).
# CRAWLING_NSM_LIST_SCAN_DEGRADED_THRESHOLD=3
# CRAWLING_NSM_LIST_SCAN_ALERT_REPEAT_HOURS=6
